# Local simulation uses labeled synthetic fixtures and makes no cloud calls.
DEMO_MODE=false

# Azure mode: resource root, e.g. https://YOUR-RESOURCE.openai.azure.com/
# compatible mode: OpenAI-compatible base URL, e.g. .../openai/v1/
OPENAI_API_MODE=azure
OPENAI_ENDPOINT=
OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=
OPENAI_DEPLOYMENT_NAME=
# Keep the existing EMBEDED spelling for backwards compatibility.
OPENAI_TEXT_EMBEDED_API_KEY=
OPENAI_TEXT_EMBEDED_DEPLOYMENT_NAME=

# Existing cosine index only; this app never creates cloud infrastructure.
PINECONE_API_KEY=
PINECONE_HERITAGE_INDEX=tour-heritage-guides
PINECONE_NAMESPACE=heritage-v1
# PINECONE_ENVIRONMENT from the old app is no longer needed.

# Either provide both keys, or use the normal AWS credential chain / IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
HERITAGE_GUIDE_S3_BUCKET=
TOURS_TABLE=Tours
USER_TOURS_TABLE=UserTours
# Confirm these values match the actual database before enabling real bookings.
BOOKABLE_STATUSES=available,active,open

RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=8
RAG_CONTEXT_CHUNKS=5
# Initial hypothesis only: calibrate on your own live golden corpus.
RAG_MIN_SCORE=0.65
EMBEDDING_BATCH_SIZE=32
# 0 discovers output dimension and validates against the existing index.
EMBEDDING_DIMENSION=0
LLM_TEMPERATURE=0
API_TIMEOUT_SECONDS=30
API_MAX_ATTEMPTS=3
MAX_PDF_BYTES=20000000
SOURCE_LINK_TTL=900
